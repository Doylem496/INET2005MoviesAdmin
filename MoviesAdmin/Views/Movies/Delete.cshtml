        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Genre.Title)
        </dd>
    </dl>
    <dl class="row text-white">
        <dt class = "col-sm-2">Release Date
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReleaseDate)
        </dd>
    </dl>
    <dl class="row text-white">
        <dt class = "col-sm-2">Runtime(minutes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RuntimeMinutes)
