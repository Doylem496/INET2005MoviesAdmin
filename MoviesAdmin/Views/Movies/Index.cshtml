@model IEnumerable<MoviesAdmin.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>All Movies</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
             
                <th>
                @Html.DisplayNameFor(model => model.Genre.Title)
            </th> 
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RuntimeMinutes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OriginCountry)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Language)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Synopsis)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AudienceRating.Title)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    <img src="@item.ImageURL" alt="@item.Title" class="thumbnail" />
                </td>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
             <td>
                @Html.DisplayFor(model => item.Genre.Title)
            </td> 
            <td>
                @Html.DisplayFor(model => item.ReleaseDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.RuntimeMinutes)
            </td>
            <td>
            @*     @Html.DisplayFor(model => item.CriticScore)
            </td>
            <td>
                @Html.DisplayFor(model => item.UserScore)
            </td> *@
            <td>
                @Html.DisplayFor(model => item.OriginCountry)
            </td>
            <td>
                @Html.DisplayFor(model => item.Language)
            </td>
            <td>
                @Html.DisplayFor(model => item.Synopsis)
            </td>
            <td>
                @Html.DisplayFor(model => item.AudienceRating.Title)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
